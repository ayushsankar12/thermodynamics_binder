   fontupper=\small}

% 13.7 quicksheet (1-page standalone quick-reference sheet environment with page boundary control)
% Use \begin{quicksheet*}[Title] on the first sheet after \binderchapter to suppress the leading \clearpage.
\NewDocumentEnvironment{quicksheet}{ s O{} g }{%
  \IfBooleanF{#1}{\clearpage}%
  \def\qs@title{#2}%
  \IfValueT{#3}{\ifx\qs@title\@empty\def\qs@title{#3}\fi}%
  \noindent\colorbox{navy}{\parbox{\dimexpr\linewidth-2\fboxsep}{%
    \sffamily\bfseries\normalsize\color{white}\strut ONE-PAGE QUICK SHEET\ifx\qs@title\@empty\else: \qs@title\fi
    \hfill{\footnotesize 2027 Thermodynamics Div C}}}%
  \par\vspace{3pt}%
}{\clearpage}

\NewDocumentEnvironment{quicksheet*}{ O{} g }{%
  \def\qs@title{#1}%
  \IfValueT{#2}{\ifx\qs@title\@empty\def\qs@title{#2}\fi}%
  \noindent\colorbox{navy}{\parbox{\dimexpr\linewidth-2\fboxsep}{%
