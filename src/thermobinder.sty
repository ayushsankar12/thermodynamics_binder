\newtcolorbox{labbox}[1][]{bindergeneral,colback=white,colframe=slate,boxrule=0.6pt,leftrule=4.0pt,
   title={\ding{45}\ DEVICE \& LAB\ifx&#1&\else: #1\fi},attach title to upper={\ \ },fontupper=\small}

% 13.5 rulebox (2027 official rules / clarification / safety hazard warning callout)
