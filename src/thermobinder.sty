% ---------------- 13. Pedagogical Callout Environments (Part D & E) -------------
\tcbset{bindergeneral/.style={enhanced,breakable,left=4pt,right=4pt,top=2pt,bottom=2pt,
        boxsep=1pt,arc=1pt,fonttitle=\sffamily\bfseries\small,coltitle=black,
        before skip=3.5pt,after skip=3.5pt}}

% 13.1 formulacard (L1 formula / decision card) + aliases formula, quick
\newtcolorbox{formulacard}[1][]{bindergeneral,colback=boxbg,colframe=navy,boxrule=0.8pt,
   title={\textsf{FORMULA \& DECISION CARD}\ifx&#1&\else\ \textperiodcentered\ #1\fi},
   colbacktitle=navy,coltitle=white,fontupper=\small}

\newtcolorbox{formula}[1][]{bindergeneral,colback=boxbg,colframe=navy,boxrule=0.7pt,
   title={\textsf{FORMULA}\ifx&#1&\else\ \textperiodcentered\ #1\fi},colbacktitle=boxbg,
   attach title to upper={\ \ },fontupper=\small}

\newtcolorbox{quick}[1][]{bindergeneral,colback=boxbg,colframe=navy,boxrule=0.8pt,
   title={QUICK REFERENCE\ifx&#1&\else\ \textperiodcentered\ #1\fi},colbacktitle=navy,coltitle=white,
   fontupper=\small}

% 13.2 workedexample (L4 worked example with mandatory \verifiedby{...}) + alias example
\newcounter{example}[chapter]
\renewcommand{\theexample}{\thechapter.\arabic{example}}

\NewDocumentEnvironment{workedexample}{ O{} g g }{%
  \refstepcounter{example}%
  \def\ex@title{#1}%
  \def\ex@meta{}%
  \IfValueT{#2}{%
    \ifx\ex@title\@empty
      \def\ex@title{#2}%
    \else
      \def\ex@meta{#2}%
    \fi}%
  \IfValueT{#3}{%
    \ifx\ex@meta\@empty
      \def\ex@meta{#3}%
    \else
      \label{#3}%
    \fi}%
  \begin{tcolorbox}[bindergeneral,colback=white,colframe=black,boxrule=0.6pt,
     title={Worked Example \theexample\ifx\ex@title\@empty\else\ --- \ex@title\fi
            \ifx\ex@meta\@empty\else\hfill{\normalfont\footnotesize[\ex@meta]}\fi},
     colbacktitle=boxbg,fontupper=\small]%
}{\end{tcolorbox}}

\newenvironment{example}[3]{\refstepcounter{example}\label{#3}%
  \begin{tcolorbox}[bindergeneral,colback=white,colframe=black,boxrule=0.6pt,
     title={Worked Example \theexample\ --- #1 \hfill{\normalfont\footnotesize[#2]}},
     colbacktitle=boxbg,fontupper=\small]}
  {\end{tcolorbox}}

\newcommand{\cmark}{\ding{51}}
\newcommand{\xmark}{\ding{55}}
\newcommand{\verifiedby}[1]{\par\noindent{\sffamily\footnotesize\textbf{\cmark\ verified by:} #1}\par}
\newcommand{\verified}[1]{\verifiedby{#1}}
\newcommand{\ifgot}[2]{\par\noindent{\small\textbf{If you got #1,} #2}\par}

% 13.3 trapbox (L5 common traps & wrong-answer diagnostics: symptom -> cause -> fix) + alias trap
\newtcolorbox{trapbox}[1][]{bindergeneral,colback=white,colframe=rust,boxrule=1.8pt,
   title={\ding{110}\ TRAP \& DIAGNOSTIC\ifx&#1&\else: #1\fi},
   colbacktitle=boxbg,coltitle=black,fontupper=\small}

\newtcolorbox{trap}[1][]{bindergeneral,colback=white,colframe=rust,boxrule=1.8pt,
   title={\ding{110}\ TRAP\ifx&#1&\else: #1\fi},attach title to upper={\ \ },fontupper=\small}

% 13.4 devicebox (L6 2027 heat-lamp collector / experimental application) + alias labbox
\newtcolorbox{devicebox}[1][]{bindergeneral,colback=white,colframe=slate,boxrule=0.6pt,leftrule=4.0pt,
   title={\ding{45}\ 2027 HEAT-COLLECTOR DEVICE \& LAB\ifx&#1&\else: #1\fi},
