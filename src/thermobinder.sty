% ---------------- 11. 9 Outer-Edge Thumb Tabs (Part G Exact 9-Tab System) -------
% Tabs:
%   1: CMD/QUICK   (§§0-1)
%   2: FOUNDATIONS (§§2-3)
%   3: CAL/PHASE   (§§4-5)
%   4: GASES/LAWS  (§§6-9)
%   5: TRANSFER    (§§10-13)
%   6: DEVICE      (§§14-16)
%   7: LAB/DATA    (§§17-18)
%   8: PROBLEMS    (§§19-23)
%   9: INDEX/APP   (App A-H & Indices)
% Geometry: 9 slots x 1.02 in = 9.18 in vertical span (top offset 0.85 in).
% Placed in the outer 0.34 in margin strip (x in [8.16in, 8.50in] on odd pages;
% x in [0.00in, 0.34in] on even pages), leaving a 0.16 in white gutter outside the text body
% and 100% opposite the 0.75 in inner 3-hole punch margin.
\newif\ifshowtabs \showtabstrue
\newcommand{\notabs}{\showtabsfalse}
\newcounter{tabslot}
\newcommand{\tablabel}{}
\newcommand{\settab}[2]{\clearpage\setcounter{tabslot}{#1}\renewcommand{\tablabel}{#2}}
\newcommand{\settabnoclear}[2]{\setcounter{tabslot}{#1}\renewcommand{\tablabel}{#2}}
\newcommand{\thermotabname}[1]{%
  \ifcase#1\or CMD/QUICK\or FOUNDATIONS\or CAL/PHASE\or GASES/LAWS\or TRANSFER\or DEVICE\or LAB/DATA\or PROBLEMS\or INDEX/APP\else TAB~#1\fi}
\newcommand{\thermotab}[1]{\settab{#1}{\thermotabname{#1}}}
\newcommand{\thermotabnoclear}[1]{\settabnoclear{#1}{\thermotabname{#1}}}

\newlength{\tabslotheight}
\setlength{\tabslotheight}{1.02in}
\AddToShipoutPictureBG{%
  \ifshowtabs
  \ifnum\value{tabslot}>0
  \AtPageUpperLeft{%
    \ifodd\value{page}
      \put(\LenToUnit{\paperwidth-0.34in},\LenToUnit{-0.85in-\value{tabslot}\tabslotheight+\tabslotheight}){%
        \makebox(0,0)[tl]{\color{tabblack}\rule{0.34in}{\tabslotheight}}}%
      \put(\LenToUnit{\paperwidth-0.17in},\LenToUnit{-0.85in-\value{tabslot}\tabslotheight+0.5\tabslotheight}){%
        \makebox(0,0){\rotatebox{-90}{\color{white}\sffamily\bfseries\scriptsize\tablabel}}}%
    \else
      \put(\LenToUnit{0in},\LenToUnit{-0.85in-\value{tabslot}\tabslotheight+\tabslotheight}){%
        \makebox(0,0)[tl]{\color{tabblack}\rule{0.34in}{\tabslotheight}}}%
      \put(\LenToUnit{0.17in},\LenToUnit{-0.85in-\value{tabslot}\tabslotheight+0.5\tabslotheight}){%
        \makebox(0,0){\rotatebox{90}{\color{white}\sffamily\bfseries\scriptsize\tablabel}}}%
    \fi}%
  \fi
  \fi}

% ---------------- 12. Scope Banners (Part D) ------------------------------------
% Supports:
%   \scopebanner{REQUIRED}
%   \scopebanner{REQUIRED}[Rule 5.c.i--v (All Levels)]
%   \scopebanner[Rule 5.c.vi--vii]{TIER-DEPENDENT}
%   \scopebanner{SUPPLEMENTARY}{Enrichment beyond 2027 written syllabus}
%   \scopebanner{VERIFY AGAINST RULES}[Host tournament parameters]
% Plus grayscale-distinct border & badge patterns for each category.
\NewDocumentCommand{\scopebanner}{ O{} m O{} g }{%
  \begingroup
  \def\sc@sub{#1}%
  \ifx\sc@sub\@empty\def\sc@sub{#3}\fi
  \IfValueT{#4}{\ifx\sc@sub\@empty\def\sc@sub{#4}\fi}%
  \par\noindent
  \tb@IfSubStr{#2}{TIER}{%
    \begin{tcolorbox}[enhanced,boxrule=0.8pt,borderline={0.6pt}{1.5pt}{amber,dotted},
      colback=boxbg,colframe=amber,arc=0.5pt,left=4pt,right=4pt,top=1.5pt,bottom=1.5pt,
      before skip=2pt,after skip=3pt]
      {\sffamily\footnotesize\bfseries\ding{73}\ SCOPE: #2}%
      \ifx\sc@sub\@empty\else\ {\sffamily\footnotesize\textbar\ \sc@sub}\fi
    \end{tcolorbox}%
  }{%
    \tb@IfSubStr{#2}{SUPP}{%
      \begin{tcolorbox}[enhanced,boxrule=0.6pt,borderline={0.5pt}{1.5pt}{black,dashed},
        colback=white,colframe=midgray,arc=0.5pt,left=4pt,right=4pt,top=1.5pt,bottom=1.5pt,
        before skip=2pt,after skip=3pt]
        {\sffamily\footnotesize\bfseries\ding{111}\ SCOPE: #2}%
        \ifx\sc@sub\@empty\else\ {\sffamily\footnotesize\textbar\ \sc@sub}\fi
      \end{tcolorbox}%
    }{%
      \tb@IfSubStr{#2}{VERIFY}{%
        \begin{tcolorbox}[enhanced,boxrule=1.2pt,borderline={0.5pt}{1.8pt}{rust},
          colback=white,colframe=rust,arc=0.5pt,left=4pt,right=4pt,top=1.5pt,bottom=1.5pt,
          before skip=2pt,after skip=3pt]
          {\sffamily\footnotesize\bfseries\ding{110}\ SCOPE: #2}%
          \ifx\sc@sub\@empty\else\ {\sffamily\footnotesize\textbar\ \sc@sub}\fi
        \end{tcolorbox}%
      }{%
        % Default / REQUIRED: high-contrast dark fill with white bold text
        \colorbox{navy}{\parbox{\dimexpr\linewidth-2\fboxsep}{\raggedright\sffamily\footnotesize\color{white}%
          \textbf{\ding{51}\ SCOPE: #2}\ifx\sc@sub\@empty\else\ \textbar\ \sc@sub\fi}}\par\vspace{3pt}%
      }%
    }%
  }%
  \endgroup
}
% Helper substring test using built-in LaTeX3 kernel \tl_if_in:nnTF
\ExplSyntaxOn
\cs_new_eq:NN \tb@IfSubStr \tl_if_in:nnTF
\ExplSyntaxOff

% Backwards-compatible alias \scope{category}{basis}
\newcommand{\scope}[2]{\scopebanner{#1}[#2]}
